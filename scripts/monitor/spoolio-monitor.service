[Unit]
Description=Comprobar API y base de datos de Spoolio
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
EnvironmentFile=/etc/spoolio-monitor.env
ExecStart=/usr/bin/node /opt/spoolio-monitor/check-health.mjs
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
